<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- El nombre "Facturacion" NO se puede cambiar:
         es el que busca Datos/FabricaConexiones.ObtenerCadenaConexion().

         Ajustá solamente el Server según tu instalación:
           .\SQLEXPRESS        -> SQL Server Express local
           (localdb)\MSSQLLocalDB -> LocalDB de Visual Studio
           localhost           -> instancia por defecto
    -->
    <add name="Facturacion"
         connectionString="Server=.\SQLEXPRESS;Database=FacturacionTP1;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
