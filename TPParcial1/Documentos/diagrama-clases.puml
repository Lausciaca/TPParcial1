@startuml Diagrama de clases - TP Facturacion
skinparam classAttributeIconSize 0

package Modelos {
  class Producto {
    + Id : int
    + Codigo : string
    + Nombre : string
    + Precio : decimal
    + Activo : bool
  }
  class Factura {
    + Id : int
    + Numero : int
    + Fecha : DateTime
    + ClienteNombre : string
    + ClienteDocumento : string
    + Total : decimal
    + Anulada : bool
    + FechaAnulacion : DateTime?
    + Detalles : List<FacturaDetalle>
    + RecalcularTotal()
  }
  class FacturaDetalle {
    + Id : int
    + FacturaId : int
    + ProductoId : int
    + Cantidad : int
    + PrecioUnitario : decimal
    + Subtotal : decimal
    + Recalcular()
  }
  class InformeProducto {
    + ProductoId : int
    + Codigo : string
    + Nombre : string
    + CantidadFacturada : int
    + Monto : decimal
  }
  Factura "1" *-- "n" FacturaDetalle
}

package Datos {
  class FabricaConexiones {
    + ObtenerCadenaConexion() : string
    + CrearConexion() : SqlConnection
  }
  class ProductoDatos {
    + Crear() : int
    + Modificar()
    + Desactivar()
    + ObtenerPorId() : Producto?
    + Buscar() : List<Producto>
    + ExisteCodigo() : bool
  }
  class FacturaDatos {
    + Emitir() : int
    + BuscarCabeceras() : List<Factura>
    + ObtenerCompleta() : Factura?
    + Anular()
  }
  class InformeDatos {
    + VentasPorProducto() : List<InformeProducto>
  }
  class AyudanteExcepciones {
    + Traducir() : Exception
  }
}

package Comun {
  class ExcepcionValidacion {
    + ExcepcionValidacion(message : string)
  }
}

package Servicios {
  class ServicioProducto {
    + Alta() : int
    + Modificar()
    + Baja()
    + Buscar() : List<Producto>
  }
  class BorradorFactura {
    + AgregarLinea()
    + QuitarLinea()
    + ValidarParaEmitir()
    + ToFactura() : Factura
  }
  class ServicioFactura {
    + NuevoBorrador() : BorradorFactura
    + Emitir() : int
    + Buscar() : List<Factura>
    + Anular()
    + InformeVentas() : List<InformeProducto>
  }
}

ServicioProducto --> ProductoDatos
ServicioProducto --> Producto
ServicioFactura --> FacturaDatos
ServicioFactura --> InformeDatos
ServicioFactura ..> BorradorFactura
FacturaDatos ..> Factura
InformeDatos ..> InformeProducto
BorradorFactura ..> Producto
BorradorFactura ..> ExcepcionValidacion
ServicioProducto ..> ExcepcionValidacion
ProductoDatos ..> ExcepcionValidacion
FacturaDatos ..> ExcepcionValidacion

note bottom
  Forms -> Servicios -> Datos -> SqlCommand -> SQL Server
  Forms NO contienen SQL (TP §5.4)
end note
@enduml
